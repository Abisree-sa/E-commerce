# SALESTORM Environment Variables Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=salestorm
DB_PASSWORD=salestorm_secret_password

# Separate logical database names
DB_PRODUCT=salestorm_product
DB_INVENTORY=salestorm_inventory
DB_PAYMENT=salestorm_payment
DB_ORDER=salestorm_order

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=300

# OpenSearch Configuration
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PRODUCTS=products

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=salestorm-consumer-group

# JWT Security Configuration
JWT_SECRET=salestorm_super_secret_jwt_key_for_hackathon_demo_2026_production_style
JWT_EXPIRATION_MS=86400000

# Rate Limiting Configuration
RATE_LIMIT_CHECKOUT_PER_MIN=60
RATE_LIMIT_SEARCH_PER_MIN=300
