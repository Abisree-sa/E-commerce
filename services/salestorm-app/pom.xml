<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.salestorm</groupId>
        <artifactId>salestorm-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>salestorm-app</artifactId>
    <name>Salestorm Platform Composite Application</name>

    <dependencies>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>product-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>search-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>recommendation-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>cart-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>checkout-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>inventory-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>payment-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>order-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>shipment-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>notification-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.salestorm</groupId>
            <artifactId>api-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.salestorm.SalestormApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
